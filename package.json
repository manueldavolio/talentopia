{
  "name": "talentopia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cloud": "cross-env CLOUD_BUILD=1 next build",
    "pages:build": "cross-env CLOUD_BUILD=1 npx @cloudflare/next-on-pages && node scripts/cloudflare-postbuild.mjs",
    "cf:dev": "npm run pages:build && wrangler dev",
    "cf:deploy": "npm run pages:build && wrangler deploy",
    "cf:pages:dev": "wrangler pages dev .vercel/output/static --compatibility-flag=nodejs_compat",
    "cf:pages:deploy": "npm run pages:build && wrangler pages deploy .vercel/output/static",
    "start": "next start",
    "lint": "eslint",
    "questions:seed": "tsx scripts/seedQuestions.ts --reset",
    "questions:verify:calcio": "tsx scripts/verifyCalcioSample.ts",
    "questions:verify:inter": "tsx scripts/verifyInterQuality.ts",
    "questions:verify:sport": "tsx scripts/verifySportQuality.ts",
    "questions:seed:full": "tsx scripts/seedQuestions.ts 1000",
    "questions:math": "tsx scripts/generateMathQuestions.ts",
    "questions:english": "tsx scripts/generateEnglishQuestions.ts",
    "questions:geography": "tsx scripts/generateGeographyQuestions.ts",
    "questions:sport": "tsx scripts/generateSportQuestions.ts",
    "questions:football": "tsx scripts/generateFootballQuestions.ts",
    "questions:history": "tsx scripts/generateHistoryQuestions.ts",
    "questions:fantacalcio": "tsx scripts/generateFantasyFootballQuestions.ts",
    "questions:french": "tsx scripts/generateFrenchQuestions.ts",
    "questions:inter": "tsx scripts/generateInterQuestions.ts",
    "questions:match-analyst": "tsx scripts/generateMatchAnalystQuestions.ts",
    "questions:patente": "tsx scripts/generatePatenteQuestions.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.107.0",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "tsx": "^4.19.4",
    "typescript": "^5",
    "wrangler": "^4.19.0"
  }
}
